# Amazon Bedrock credentials for the agent's LLM calls. Passed to the container with --env-file.
# Copy to config/bedrock.env, fill in, chmod 600. Prefer short-lived credentials (STS / SSO); scope
# the role to bedrock:InvokeModel and bedrock:InvokeModelWithResponseStream.

# <AWS_REGION> — the Bedrock region you call
AWS_REGION=eu-central-1

# <AWS_ACCESS_KEY_ID> — ASIA… for temporary credentials, AKIA… for long-lived ones
AWS_ACCESS_KEY_ID=ASIAxxxxxxxxxxxxxxxx

# <AWS_SECRET_ACCESS_KEY> — 40 characters
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# <AWS_SESSION_TOKEN> — only for temporary credentials; delete the line for long-lived keys
AWS_SESSION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# <BEDROCK_MODEL_ID> — in regions where Claude is offered only through cross-region inference profiles,
#   this must be the INFERENCE PROFILE id (region prefix, e.g. eu. / us.), not the bare model id.
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
