# agent0 agent runtime — Microsoft Entra ID values.
# Copy to config/agent0.env.agent, fill in, chmod 600. Mounted read-only at /app/packages/agent0/.env.agent.
#
# The Okta-only keys of the upstream example (AI_AGENT_*, MCP_AUTHORIZATION_SERVER*) are deliberately
# absent: they configure Okta's Cross App Access exchange, which On-Behalf-Of replaces on Entra.
# AWS credentials are NOT here — they come from config/bedrock.env (see deploy/run.sh).
# Leave ANTHROPIC_API_KEY unset: if present it takes priority over Bedrock and bypasses the ZIA path.

# IDP=entra (which selects the Entra code path) is NOT set here: deploy/run.sh passes it as container
# environment, because several modules read it before this file is loaded.

# <ENTRA_AUTHORITY> — same value as OKTA_DOMAIN in agent0.env.app
OKTA_DOMAIN=login.microsoftonline.com/cddbxxxx-xxxx-xxxx-xxxx-xxxxxxxxf7c6/v2.0

# The todo0 MCP server, on loopback inside the same container. Not proxied, never published.
MCP_SERVER_URL=http://localhost:5002/mcp

# <TODO0_SCOPES> — the three scopes exposed by the todo0 app, SPACE-separated on one line:
#   api://<TODO0_APP_ID>/mcp:connect api://<TODO0_APP_ID>/mcp:tools:read api://<TODO0_APP_ID>/mcp:tools:manage
#   One access token carries one audience, so all three must come from the same app (one OBO call).
ENTRA_TODO0_SCOPES=api://d5ccxxxx-xxxx-xxxx-xxxx-xxxxxxxx5729/mcp:connect api://d5ccxxxx-xxxx-xxxx-xxxx-xxxxxxxx5729/mcp:tools:read api://d5ccxxxx-xxxx-xxxx-xxxx-xxxxxxxx5729/mcp:tools:manage

# <ZIA_PROXY> — your ZIA explicit proxy as host:port: a Service Edge address or your cloud's gateway
#   hostname (gateway.<zscaler-cloud>.net:80). It must be the EXPLICIT proxy — traffic on a default route
#   or a transparent tunnel is not proxy-authenticated. There is deliberately no default.
ZIA_PROXY=185.46.xxx.xxx:80

# The upstream sample's GitHub ("application") connection needs Okta-brokered consent; off on Entra.
DISABLED_CONNECTIONS=application
