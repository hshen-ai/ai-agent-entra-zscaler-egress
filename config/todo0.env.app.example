# todo0 web UI (port 5001) — Microsoft Entra ID values.
# Copy to config/todo0.env.app, fill in, chmod 600. Mounted read-only at /app/packages/todo0/.env.app.
#
# The todo0 app registration is BOTH the MCP resource server and the client for this web login.
# This UI is where a person sees the todo the agent created through MCP.

PORT=5001

# <SESSION_SECRET> — a DIFFERENT random string from agent0's. Generate: openssl rand -hex 32
SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# <ENTRA_ISSUER> — https://login.microsoftonline.com/<TENANT_ID>/v2.0 (here WITH https://)
OKTA_ISSUER=https://login.microsoftonline.com/cddbxxxx-xxxx-xxxx-xxxx-xxxxxxxxf7c6/v2.0

# <TODO0_APP_ID> — Application (client) ID of the todo0 app registration
OKTA_CLIENT_ID=d5ccxxxx-xxxx-xxxx-xxxx-xxxxxxxx5729

# <TODO0_CLIENT_SECRET> — a client secret VALUE of the todo0 app registration
OKTA_CLIENT_SECRET=xxx8Q~xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# <TODO0_REDIRECT_URI> — registered on todo0 as a "Web" platform redirect URI
OKTA_REDIRECT_URI=http://localhost:5001/callback

# Required by the upstream config validator; not read by any todo0 code path on Entra.
EXPECTED_AUDIENCE=d5ccxxxx-xxxx-xxxx-xxxx-xxxxxxxx5729

AUTH_DEBUG=false
