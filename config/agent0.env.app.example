# agent0 web app (port 3000) — Microsoft Entra ID values.
# Copy to config/agent0.env.app, fill in, chmod 600. Mounted read-only at /app/packages/agent0/.env.app.
#
# The OKTA_* key NAMES are kept because the upstream code reads those names; only the values are
# Entra's. The app builds its OIDC discovery URL as https://${OKTA_DOMAIN}/.well-known/openid-configuration,
# so pointing OKTA_DOMAIN at Entra's v2.0 authority is the whole IdP switch for the login itself.
#
# Every example value below is a real, MASKED value from the reference lab, so you can see the exact
# format. The comment above each key names the generic placeholder and where to find your own value.

PORT=3000

# <SESSION_SECRET> — random string signing the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# <ENTRA_AUTHORITY> — login.microsoftonline.com/<TENANT_ID>/v2.0
#   NO https:// prefix and NO trailing slash: the code prepends the scheme itself.
OKTA_DOMAIN=login.microsoftonline.com/cddbxxxx-xxxx-xxxx-xxxx-xxxxxxxxf7c6/v2.0

# <AGENT0_CLIENT_ID> — Application (client) ID of the agent0 app registration
#   Entra admin center > App registrations > agent0-entra > Overview
OKTA_CLIENT_ID=1135xxxx-xxxx-xxxx-xxxx-xxxxxxxx4766

# <AGENT0_CLIENT_SECRET> — a client secret VALUE of the agent0 app registration (not its secret ID)
#   Certificates & secrets > Client secrets. Entra shows it exactly once. 40 characters, "Q~" at 5-6.
OKTA_CLIENT_SECRET=xxx8Q~xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# <AGENT0_REDIRECT_URI> — must be registered on agent0 as a "Web" platform redirect URI, exactly
OKTA_REDIRECT_URI=http://localhost:3000/callback

# <IDP_LOGIN_SCOPES> — space-separated. Must include api://<AGENT0_CLIENT_ID>/agent.access: On-Behalf-Of
#   needs an ACCESS token whose audience is agent0 itself (an ID token cannot be the assertion).
#   offline_access adds a refresh token so a session can outlive one hour.
IDP_LOGIN_SCOPES=openid profile email offline_access api://1135xxxx-xxxx-xxxx-xxxx-xxxxxxxx4766/agent.access

# <TENANT_ID> — Directory (tenant) ID. Entra admin center > Overview > Tenant ID
ENTRA_TENANT_ID=cddbxxxx-xxxx-xxxx-xxxx-xxxxxxxxf7c6

# <ZIA_EGRESS_SCOPE> — api://<ZIA_EGRESS_APP_ID>/zia:egress — the scope exposed by the zia-egress app.
#   The token minted for it is what the agent sends to ZIA as Proxy-Authorization: Bearer.
ENTRA_ZIA_EGRESS_SCOPE=api://a015xxxx-xxxx-xxxx-xxxx-xxxxxxxxc4d6/zia:egress
