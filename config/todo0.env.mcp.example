# todo0 MCP server (port 5002, loopback only) — Microsoft Entra ID values.
# Copy to config/todo0.env.mcp, fill in, chmod 600. Mounted read-only at /app/packages/todo0/.env.mcp.

MCP_PORT=5002

# <ENTRA_ISSUER> — https://login.microsoftonline.com/<TENANT_ID>/v2.0
#   The v2.0 form. The server derives Entra's JWKS URL from it, and a v1 token (iss=https://sts.windows.net/...)
#   is rejected — the app registrations request v2 tokens (requestedAccessTokenVersion = 2).
MCP_OKTA_ISSUER=https://login.microsoftonline.com/cddbxxxx-xxxx-xxxx-xxxx-xxxxxxxxf7c6/v2.0

# <TODO0_APP_ID> — the BARE GUID, NOT api://<TODO0_APP_ID>. A real OBO token's `aud` is the bare
#   application ID; the api:// form here rejects every valid token.
MCP_EXPECTED_AUDIENCE=d5ccxxxx-xxxx-xxxx-xxxx-xxxxxxxx5729
